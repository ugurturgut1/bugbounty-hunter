# Copy to .env and fill in what you have. Each platform connector is
# skipped (not scraped as a fallback) if its credentials are absent.
#
# IMPORTANT: never put real values in THIS file -- it's tracked by git.
# Real credentials go in .env, which is gitignored.

# HackerOne: Settings -> API Token (https://hackerone.com/settings/api_token/edit)
H1_API_USERNAME=
H1_API_TOKEN=

# Bugcrowd: deprioritized -- API Credentials generation in account
# settings appears to be a customer/org-only feature, not available to
# individual hacker/researcher accounts. See README.md.
BUGCROWD_API_USERNAME=
BUGCROWD_API_PASSWORD=

# Intigriti: personal access token
INTIGRITI_API_TOKEN=

# YesWeHack: skipped for now, see discovery/yeswehack.py
YWH_API_TOKEN=
