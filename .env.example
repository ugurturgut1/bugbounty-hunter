# Copy to .env and fill in what you have. Each platform connector is
# skipped (not scraped as a fallback) if its credentials are absent.

# HackerOne: Settings -> API Token (https://hackerone.com/settings/api_token/edit)
H1_API_USERNAME=
H1_API_TOKEN=

# Bugcrowd: API credentials from account settings -> API Credentials
# (a username + secret pair, not a single token -- see
# docs.bugcrowd.com/api/getting-started/)
BUGCROWD_API_USERNAME=
BUGCROWD_API_PASSWORD=

# Intigriti: personal access token (not yet wired up, see discovery/intigriti.py)
INTIGRITI_API_TOKEN=

# YesWeHack: API token (not yet wired up, see discovery/yeswehack.py)
YWH_API_TOKEN=
